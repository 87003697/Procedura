diff --git a/src/pipeline/mesh-to-cad.ts b/src/pipeline/mesh-to-cad.ts
new file mode 100644
index 0000000..2773394
--- /dev/null
+++ b/src/pipeline/mesh-to-cad.ts
@@ -0,0 +1,38 @@
+import {
+  observeReferenceRun,
+  type ObserveReferenceRunOpts,
+  type ObserveReferenceRunResult,
+} from "./mesh-to-cad-reference.ts";
+import { runProcedura, type RunProceduraResult } from "./procedura.ts";
+import type { ReconstructionBrief } from "../reference/observer.ts";
+
+export interface RunMeshToCadOpts extends ObserveReferenceRunOpts {
+  scadModel?: string;
+}
+
+export interface RunMeshToCadResult extends ObserveReferenceRunResult {
+  generation: RunProceduraResult;
+}
+
+function generationText(userText: string | undefined, brief: ReconstructionBrief): string {
+  return [
+    userText?.trim() || "Reconstruct this mesh faithfully as editable parametric CAD.",
+    "The trusted reference observer produced this measured reconstruction brief:",
+    JSON.stringify(brief, null, 2),
+    "Use the measured dimensions. Model only features supported by the brief and attached reference views.",
+  ].join("\n\n");
+}
+
+export async function runMeshToCad(opts: RunMeshToCadOpts): Promise<RunMeshToCadResult> {
+  const observed = await observeReferenceRun(opts);
+  const generation = await runProcedura({
+    outputDir: observed.outputDir,
+    text: generationText(opts.text, observed.observation.brief),
+    inputImages: observed.observation.renderPaths,
+    incremental: true,
+    refine: false,
+    ...(opts.scadModel ? { scadModel: opts.scadModel } : {}),
+    ...(opts.signal ? { signal: opts.signal } : {}),
+  });
+  return { ...observed, generation };
+}
