+#!/usr/bin/env bun
+
+import { importReferenceRun } from "../src/pipeline/mesh-to-cad-reference.ts";
+
+interface Args {
+  outputDir: string;
+  meshPath?: string;
+  referenceHandle?: string;
+  referenceRoot?: string;
+  runsRoot?: string;
+  importOnly: boolean;
+}
+
+function help(): never {
+  console.log(`
+Mesh-to-CAD Plan 1 — private reference import and local Viewer.
+
+Usage:
+  bun run mesh-to-cad --import-only --mesh reference.stl -o outputs/reference-import
+  bun run mesh-to-cad --import-only --reference-handle HANDLE -o outputs/reference-import
+
+Options:
+  --import-only               import/reuse a reference without LLM or CAD generation
+  --mesh PATH                 import a CAD Z-up STL or OBJ
+  --reference-handle HANDLE   reuse an existing opaque handle
+  --reference-root PATH       private store root (or PROCEDURA_REFERENCE_ROOT)
+  --runs-root PATH            Studio runs root (or PROCEDURA_OUTPUTS_ROOT)
+  -o, --output PATH           output run directory
+`);
+  process.exit(0);
+}
+
+function parse(argv: string[]): Args {
+  const args: Args = { outputDir: "", importOnly: false };
+  for (let i = 0; i < argv.length; i++) {
+    const value = argv[i]!;
+    if (value === "-o" || value === "--output") args.outputDir = argv[++i]!;
+    else if (value === "--mesh") args.meshPath = argv[++i]!;
+    else if (value === "--reference-handle") args.referenceHandle = argv[++i]!;
+    else if (value === "--reference-root") args.referenceRoot = argv[++i]!;
+    else if (value === "--runs-root") args.runsRoot = argv[++i]!;
+    else if (value === "--import-only") args.importOnly = true;
+    else if (value === "-h" || value === "--help") help();
+    else throw new Error(`unknown flag: ${value}`);
+  }
+  if (!args.importOnly) throw new Error("Plan 1 requires --import-only");
+  if (!args.outputDir) throw new Error("-o/--output is required");
+  if (Boolean(args.meshPath) === Boolean(args.referenceHandle)) {
+    throw new Error("pass exactly one of --mesh or --reference-handle");
+  }
+  return args;
+}
+
+const args = parse(process.argv.slice(2));
+const result = importReferenceRun({
+  outputDir: args.outputDir,
+  ...(args.meshPath ? { meshPath: args.meshPath } : {}),
+  ...(args.referenceHandle ? { referenceHandle: args.referenceHandle } : {}),
+  ...(args.referenceRoot ? { referenceRoot: args.referenceRoot } : {}),
+  ...(args.runsRoot ? { runsRoot: args.runsRoot } : {}),
+});
+console.log(`reference: ${result.reference.handle}`);
+console.log(`format: ${result.summary.format}`);
+console.log(`dimensions: ${result.summary.dimensions.join(" × ")}`);
diff --git a/src/pipeline/mesh-to-cad-reference.ts b/src/pipeline/mesh-to-cad-reference.ts
new file mode 100644
index 0000000..1cdbd08
--- /dev/null
+++ b/src/pipeline/mesh-to-cad-reference.ts
@@ -0,0 +1,55 @@
+import { mkdirSync, writeFileSync } from "node:fs";
+import { dirname, isAbsolute, join, relative, resolve } from "node:path";
+
+import {
+  ReferenceAuthority,
+  type ReferenceDescriptor,
+  type ReferenceSummary,
+} from "../reference/authority.ts";
+
+const PROCEDURA_ROOT = resolve(dirname(new URL(import.meta.url).pathname), "..", "..");
+
+export interface ImportReferenceRunOpts {
+  outputDir: string;
+  meshPath?: string;
+  referenceHandle?: string;
+  referenceRoot?: string;
+  runsRoot?: string;
+}
+
+export interface ImportReferenceRunResult {
+  outputDir: string;
+  reference: ReferenceDescriptor;
+  summary: ReferenceSummary;
+}
+
+function isInside(path: string, root: string): boolean {
+  const rel = relative(root, path);
+  return rel === "" || (!rel.startsWith("..") && !isAbsolute(rel));
+}
+
+export function importReferenceRun(opts: ImportReferenceRunOpts): ImportReferenceRunResult {
+  if (Boolean(opts.meshPath) === Boolean(opts.referenceHandle)) {
+    throw new Error("importReferenceRun requires exactly one of meshPath or referenceHandle");
+  }
+  const outputDir = resolve(opts.outputDir);
+  const runsRoot = resolve(opts.runsRoot ?? process.env["PROCEDURA_OUTPUTS_ROOT"] ?? join(PROCEDURA_ROOT, "outputs"));
+  if (!isInside(outputDir, runsRoot)) throw new Error("outputDir must be inside runsRoot");
+  const configuredRoot = opts.referenceRoot ?? process.env["PROCEDURA_REFERENCE_ROOT"];
+  if (!configuredRoot) throw new Error("Mesh-to-CAD requires --reference-root or PROCEDURA_REFERENCE_ROOT");
+  const authority = new ReferenceAuthority(resolve(configuredRoot), [runsRoot, PROCEDURA_ROOT]);
+  mkdirSync(outputDir, { recursive: true });
+  const reference = opts.meshPath
+    ? authority.importReference(opts.meshPath)
+    : {
+        handle: opts.referenceHandle!,
+        format: authority.inspectReferenceSummary(opts.referenceHandle!).format,
+      };
+  const summary = authority.inspectReferenceSummary(reference.handle);
+  writeFileSync(join(outputDir, "reference.json"), JSON.stringify({
+    schemaVersion: 1,
+    handle: reference.handle,
+    format: reference.format,
+  }, null, 2), "utf8");
+  return { outputDir, reference, summary };
+}
diff --git a/src/reference/authority.ts b/src/reference/authority.ts
new file mode 100644
index 0000000..f60a084
--- /dev/null
+++ b/src/reference/authority.ts
@@ -0,0 +1,108 @@
+import { randomUUID } from "node:crypto";
+import { copyFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { extname, isAbsolute, join, relative, resolve } from "node:path";
+
+import { loadOBJ } from "../mesh/obj.ts";
+import { computeBBox, loadSTL, type STLMesh } from "../mesh/stl.ts";
+
+export type ReferenceFormat = "stl" | "obj";
+
+interface PrivateManifest {
+  handle: string;
+  format: ReferenceFormat;
+  sourceFile: string;
+}
+
+export interface ReferenceDescriptor {
+  handle: string;
+  format: ReferenceFormat;
+}
+
+export interface ReferenceSummary {
+  format: ReferenceFormat;
+  coordinateConvention: "Z-up";
+  triangleCount: number;
+  dimensions: [number, number, number];
+}
+
+export interface ReferenceSource {
+  format: ReferenceFormat;
+  bytes: Uint8Array;
+}
+
+function formatOf(path: string): ReferenceFormat {
+  const ext = extname(path).toLowerCase();
+  if (ext === ".stl") return "stl";
+  if (ext === ".obj") return "obj";
+  throw new Error("reference mesh must be STL or OBJ");
+}
+
+function loadMesh(path: string, format: ReferenceFormat): STLMesh {
+  return format === "stl" ? loadSTL(path) : loadOBJ(path);
+}
+
+function isInside(path: string, root: string): boolean {
+  const rel = relative(root, path);
+  return rel === "" || (!rel.startsWith("..") && !isAbsolute(rel));
+}
+
+export class ReferenceAuthority {
+  readonly #root: string;
+
+  constructor(root: string, forbiddenRoots: readonly string[]) {
+    const privateRoot = resolve(root);
+    for (const forbidden of forbiddenRoots.map((value) => resolve(value))) {
+      if (isInside(privateRoot, forbidden) || isInside(forbidden, privateRoot)) {
+        throw new Error("reference root must be disjoint from runs and workspace roots");
+      }
+    }
+    this.#root = privateRoot;
+  }
+
+  importReference(sourcePath: string): ReferenceDescriptor {
+    const source = resolve(sourcePath);
+    if (!existsSync(source)) throw new Error(`reference mesh not found: ${source}`);
+    const format = formatOf(source);
+    const mesh = loadMesh(source, format);
+    const dimensions = computeBBox(mesh).size;
+    if (mesh.triCount === 0) throw new Error("reference mesh contains no triangles");
+    if (!dimensions.every(Number.isFinite)) throw new Error("reference dimensions must be finite");
+    const handle = `ref_${randomUUID()}`;
+    const dir = join(this.#root, handle);
+    const sourceFile = `source.${format}`;
+    mkdirSync(dir, { recursive: true });
+    copyFileSync(source, join(dir, sourceFile));
+    const manifest: PrivateManifest = { handle, format, sourceFile };
+    writeFileSync(join(dir, "manifest.json"), JSON.stringify(manifest, null, 2), "utf8");
+    return { handle, format };
+  }
+
+  inspectReferenceSummary(handle: string): ReferenceSummary {
+    const reference = this.#record(handle);
+    const mesh = loadMesh(reference.sourcePath, reference.format);
+    const dimensions = computeBBox(mesh).size;
+    if (mesh.triCount === 0 || !dimensions.every(Number.isFinite)) {
+      throw new Error("reference geometry is not measurable");
+    }
+    return {
+      format: reference.format,
+      coordinateConvention: "Z-up",
+      triangleCount: mesh.triCount,
+      dimensions,
+    };
+  }
+
+  readReferenceSource(handle: string): ReferenceSource {
+    const reference = this.#record(handle);
+    return { format: reference.format, bytes: readFileSync(reference.sourcePath) };
+  }
+
+  #record(handle: string): PrivateManifest & { sourcePath: string } {
+    if (!/^ref_[0-9a-f-]+$/.test(handle)) throw new Error("invalid reference handle");
+    const dir = join(this.#root, handle);
+    const manifestPath = join(dir, "manifest.json");
+    if (!existsSync(manifestPath)) throw new Error(`reference not found: ${handle}`);
+    const manifest = JSON.parse(readFileSync(manifestPath, "utf8")) as PrivateManifest;
+    return { ...manifest, sourcePath: join(dir, manifest.sourceFile) };
+  }
+}
