diff --git a/src/reference/normalization.ts b/src/reference/normalization.ts
new file mode 100644
index 0000000..68baa98
--- /dev/null
+++ b/src/reference/normalization.ts
@@ -0,0 +1,50 @@
+import { existsSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+
+import { loadOBJ } from "../mesh/obj.ts";
+import { loadSTL, writeSTL } from "../mesh/stl.ts";
+import { BLENDER_BIN } from "../render/blender.ts";
+export type ReferenceFormat = "stl" | "obj" | "ply" | "glb" | "gltf" | "3mf";
+
+const PROCEDURA_ROOT = resolve(dirname(new URL(import.meta.url).pathname), "..", "..");
+const NORMALIZE_SCRIPT = join(PROCEDURA_ROOT, "scripts", "_normalize_reference_blender.py");
+
+export async function normalizeReference(
+  sourcePath: string,
+  format: ReferenceFormat,
+  outputPath: string,
+): Promise<void> {
+  if (format === "stl") {
+    writeSTL(outputPath, loadSTL(sourcePath));
+    return;
+  }
+  if (format === "obj") {
+    writeSTL(outputPath, loadOBJ(sourcePath));
+    return;
+  }
+  if (!existsSync(NORMALIZE_SCRIPT)) {
+    throw new Error(`reference normalization script not found: ${NORMALIZE_SCRIPT}`);
+  }
+  const proc = Bun.spawn([
+    BLENDER_BIN,
+    "--background",
+    "--factory-startup",
+    "--python", NORMALIZE_SCRIPT,
+    "--",
+    "--input", sourcePath,
+    "--format", format,
+    "--output", outputPath,
+  ], { stdout: "pipe", stderr: "pipe" });
+  const timeoutMs = Number(process.env["PROCEDURA_RENDER_TIMEOUT_MS"]) || 600_000;
+  const killer = setTimeout(() => proc.kill(), timeoutMs);
+  const [stdout, stderr, exitCode] = await Promise.all([
+    new Response(proc.stdout).text(),
+    new Response(proc.stderr).text(),
+    proc.exited,
+  ]);
+  clearTimeout(killer);
+  if (exitCode !== 0 || !existsSync(outputPath)) {
+    const detail = stderr.trim() || stdout.trim() || `exit ${exitCode}`;
+    throw new Error(`reference normalization failed: ${detail}`);
+  }
+}
