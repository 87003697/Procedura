+++ b/src/render/blender.ts
@@ -0,0 +1,20 @@
+import { existsSync } from "node:fs";
+import { join } from "node:path";
+
+const BLENDER_CANDIDATES = [
+  ...(process.env["HOME"] ? [join(process.env["HOME"], "opt", "blender", "blender")] : []),
+  "/Applications/Blender.app/Contents/MacOS/Blender",
+  "/usr/local/bin/blender",
+  "/opt/blender/blender",
+] as const;
+
+export function resolveBlenderBin(): string {
+  const configured = process.env["PROCEDURA_BLENDER_PATH"];
+  if (configured) return configured;
+  for (const candidate of BLENDER_CANDIDATES) {
+    if (existsSync(candidate)) return candidate;
+  }
+  return Bun.which("blender") ?? BLENDER_CANDIDATES[0]!;
+}
+
+export const BLENDER_BIN = resolveBlenderBin();
