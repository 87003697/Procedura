diff --git a/src/reference/observer.ts b/src/reference/observer.ts
new file mode 100644
index 0000000..2cf2c1a
--- /dev/null
+++ b/src/reference/observer.ts
@@ -0,0 +1,94 @@
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+
+import type { CanonicalPart } from "@harness/template/llm/protocol";
+import { z } from "zod";
+
+import { resolveModel } from "../config/models.ts";
+import { generateOnce } from "../llm/generate.ts";
+import { routeForModel } from "../llm/routes.ts";
+import { REFERENCE_VIEWS, ReferenceAuthority, type ReferenceView } from "./authority.ts";
+
+const ROOT = resolve(dirname(new URL(import.meta.url).pathname), "..", "..");
+const SYSTEM = readFileSync(join(ROOT, "prompts", "reference_observer_system.md"), "utf8");
+
+const ObserverDraftSchema = z.object({
+  objectSummary: z.string().min(1),
+  parts: z.array(z.object({ name: z.string().min(1), description: z.string().min(1) })).min(1),
+  features: z.array(z.string().min(1)),
+  symmetry: z.array(z.string().min(1)),
+  geometryObservations: z.array(z.string().min(1)).min(1),
+}).strict();
+
+export interface ReconstructionBrief {
+  objectSummary: string;
+  dimensions: [number, number, number];
+  parts: { name: string; description: string }[];
+  features: string[];
+  symmetry: string[];
+  geometryObservations: string[];
+  views: { view: ReferenceView; artifact: string }[];
+}
+
+export interface ObservationResult {
+  brief: ReconstructionBrief;
+  briefPath: string;
+  renderPaths: string[];
+}
+
+function jsonObject(text: string): unknown {
+  const fenced = text.match(/```(?:json)?\s*([\s\S]*?)```/i)?.[1];
+  const source = fenced ?? text.slice(text.indexOf("{"), text.lastIndexOf("}") + 1);
+  return JSON.parse(source);
+}
+
+export async function observeReference(args: {
+  authority: ReferenceAuthority;
+  referenceHandle: string;
+  outputDir: string;
+  model?: string;
+  userPrompt?: string;
+  signal?: AbortSignal;
+}): Promise<ObservationResult> {
+  const outDir = resolve(args.outputDir);
+  const renderDir = join(outDir, "_reference_observer", "renders");
+  mkdirSync(renderDir, { recursive: true });
+  const summary = args.authority.inspectReferenceSummary(args.referenceHandle);
+  const renderPaths: string[] = [];
+  const parts: CanonicalPart[] = [
+    { kind: "text", text: `REFERENCE HANDLE: ${args.referenceHandle}` },
+    { kind: "text", text: `HOST SUMMARY: ${JSON.stringify(summary)}` },
+  ];
+  if (args.userPrompt?.trim()) {
+    parts.push({ kind: "text", text: `USER INTENT: ${args.userPrompt.trim()}` });
+  }
+  for (const view of REFERENCE_VIEWS) {
+    const rendered = await args.authority.renderReferenceView(args.referenceHandle, view);
+    const path = join(renderDir, `ao-${view}.png`);
+    writeFileSync(path, rendered.png);
+    renderPaths.push(path);
+    parts.push({ kind: "text", text: `FIXED VIEW: ${view}` });
+    parts.push({ kind: "image", data: Buffer.from(rendered.png).toString("base64"), mimeType: "image/png" });
+  }
+  const modelKey = args.model ?? "gpt-5.5";
+  const result = await generateOnce({
+    route: routeForModel(modelKey),
+    model: resolveModel(modelKey),
+    system: SYSTEM,
+    parts,
+    singleRequest: true,
+    ...(args.signal ? { signal: args.signal } : {}),
+  });
+  const draft = ObserverDraftSchema.parse(jsonObject(result.text));
+  const brief: ReconstructionBrief = {
+    ...draft,
+    dimensions: summary.dimensions,
+    views: REFERENCE_VIEWS.map((view) => ({
+      view,
+      artifact: `_reference_observer/renders/ao-${view}.png`,
+    })),
+  };
+  const briefPath = join(outDir, "reconstruction-brief.json");
+  writeFileSync(briefPath, JSON.stringify(brief, null, 2), "utf8");
+  return { brief, briefPath, renderPaths };
+}
