# Procedura local configuration template.
# Setup rebuilds .env from this file and $HOME/.secrets/procedura.env.
# Never put real secrets in this tracked template.

# OpenAI-compatible LLM endpoint and key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional native Gemini endpoint and key.
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Default model/provider selection.
# PROCEDURA_MODEL=gpt-5.2
# PROCEDURA_PROVIDER=openai
# PROCEDURA_REASONING_EFFORT=high

# Optional reference-image generation.
# PROCEDURA_IMAGE_MODEL=gpt-image-1
# PROCEDURA_IMAGE_API_URL=

# External tools and private mesh storage.
# OPENSCAD_PATH=/path/to/openscad
# PROCEDURA_BLENDER_PATH=/path/to/blender
# PROCEDURA_REFERENCE_ROOT=/absolute/path/to/references
# PROCEDURA_ISAACSIM_PATH=/absolute/path/to/isaacsim

# Optional LLM timing and retry limits (milliseconds/counts).
# PROCEDURA_LLM_TIMEOUT_MS=600000
# PROCEDURA_LLM_DEADLINE_MS=600000
# PROCEDURA_LLM_MAX_ATTEMPTS=5
# PROCEDURA_LLM_STREAM_IDLE_MS=300000
