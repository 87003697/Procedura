# Procedura configuration. Copy to `.env` and fill in — Bun loads it
# automatically, or point at it explicitly with `bun --env-file=.env ...`.
#
# Procedura ships no hosted backend and no keys. It talks to whatever endpoint
# you configure below, so the same code runs against the OpenAI API, the Google
# GenAI API, OpenRouter, a corporate gateway, or a local server.

# ─── LLM: OpenAI-compatible endpoint (the default provider) ──────────────────
# Any server exposing POST {OPENAI_BASE_URL}/chat/completions with SSE. Point it
# at api.openai.com, OpenRouter, a gateway, or a local vLLM / Ollama / LM Studio.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── LLM: Google Gemini, native GenAI path (optional) ────────────────────────
# Only needed for model keys that resolve to the `gemini` provider. Leave
# GEMINI_API_KEY empty if your gateway injects its own upstream credentials.
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ─── Model selection ─────────────────────────────────────────────────────────
# The model every stage uses unless a CLI flag overrides it. Any id your
# endpoint serves works; prefix with `openai:` or `gemini:` to force a transport
# (e.g. gemini:gemini-3-pro-preview). See src/config/models.ts.
# PROCEDURA_MODEL=gpt-5.2

# ─── Reference-image generation (OFF by default) ─────────────────────────────
# Procedura reconstructs a reference image. With this UNSET it will not call an
# image API on your behalf: supply the reference with `--image <path>`, or opt
# out of references entirely with `--no-image`. Set it to enable generation —
# the endpoint and key come from OPENAI_BASE_URL / OPENAI_API_KEY above.
# PROCEDURA_IMAGE_MODEL=gpt-image-1

# Provider used for a model key that has no prefix and no catalog entry.
# `openai` (default) or `gemini`.
# PROCEDURA_PROVIDER=openai

# Sent as the `reasoning_effort` body param on OpenAI-compatible calls. Unset by
# default, because endpoints serving non-OpenAI models reject the parameter.
# Typical values: low | medium | high.
# PROCEDURA_REASONING_EFFORT=high

# Full-URL override, if your gateway puts image generation somewhere other
# than {OPENAI_BASE_URL}/images/generations.
# PROCEDURA_IMAGE_API_URL=

# ─── External binaries ───────────────────────────────────────────────────────
# OpenSCAD must be a MANIFOLD-capable build (2023.03+ or a recent snapshot).
# A pre-Manifold binary falls back to CGAL and is orders of magnitude slower —
# a single hull() measured 1774s against 1.77s. Left unset, Procedura searches
# $PATH and a few conventional install locations, and refuses to run on a
# non-Manifold build unless PROCEDURA_ALLOW_CGAL_OPENSCAD=1.
# OPENSCAD_PATH=/usr/local/bin/openscad

# Blender, for the AO / parts-colour / PBR renders the critic looks at.
# PROCEDURA_BLENDER_PATH=/usr/local/bin/blender

# Private source meshes for Mesh-to-CAD. The CLI and Studio must share this
# directory; run outputs contain only opaque reference handles.
# PROCEDURA_REFERENCE_ROOT=/absolute/path/outside-procedura-outputs/references

# NVIDIA Isaac Sim, only for `--motion` physics validation. Defaults to ~/isaacsim.
# PROCEDURA_ISAACSIM_PATH=

# ─── LLM resilience (defaults are usually fine) ──────────────────────────────
# PROCEDURA_LLM_TIMEOUT_MS=600000       # per-attempt timeout
# PROCEDURA_LLM_DEADLINE_MS=600000      # wall-clock cap across retries
# PROCEDURA_LLM_MAX_ATTEMPTS=5
# PROCEDURA_LLM_STREAM_IDLE_MS=300000   # kill a stream that stops emitting
