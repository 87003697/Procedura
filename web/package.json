{
  "name": "procedura-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Procedura Studio — generate shape-as-code models from a prompt (and optional reference image) and inspect every intermediate artifact of a run: plan, parts, refine loop, final mesh, materials, articulation.",
  "scripts": {
    "dev": "bun run --hot server.ts",
    "start": "NODE_ENV=production bun run server.ts",
    "typecheck": "tsc --noEmit",
    "shot": "bun run scripts/shot.mjs",
    "shot:job": "bun run scripts/shot-job.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.1.0",
    "@fontsource-variable/geist-mono": "^5.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.7",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "bun-plugin-tailwind": "^0.0.15",
    "playwright-core": "^1.60.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
